# Game server settings. Copy to .env, change the values and start with: node --env-file=.env dist/server.mjs
# A line starting with "#" shows an optional setting at its default; remove the "#" to change it.

# Required: Postgres of the game server (rounds are kept here without expiry)
DATABASE_URL=postgres://slots:change-me@localhost:5432/slots

# Required: origins allowed to frame a game window, sent as Content-Security-Policy frame-ancestors
FRAME_ANCESTORS=https://casino.example.com

# Required: the game hub's address, without the /webhook/<partner> part
HUB_BASE_URL=https://hub.example.com

# Required: the partner's secret key at the hub; every call to the hub is signed with it (HMAC-SHA256)
HUB_SECRET_KEY=change-me

# Partner name in the hub's webhook path /webhook/<partner>/...
# HUB_PARTNER=ownslots

# Port the server listens on
# PORT=3000

# Folder holding play/<symbol>/ built by "npm run build:games", relative to the working directory
# PUBLIC_DIR=public

# pino log level: fatal, error, warn, info, debug, trace or silent
# LOG_LEVEL=info

# Timeout of one hub call and the time a spin waits for its bet to be answered, in milliseconds
# HUB_CALL_TIMEOUT_MS=10000

# How long the sweeper holds a round it is repeating, in milliseconds: must exceed HUB_CALL_TIMEOUT_MS (default: HUB_CALL_TIMEOUT_MS + 2000)
# SWEEP_LEASE_MS=12000

# Pause between sweeper passes over unfinished bets and wins, in milliseconds
# SWEEP_INTERVAL_MS=1000

# A bet or win failing more than this many times logs bet_pending_alert or win_pending_alert on every further attempt
# ALERT_AFTER_ATTEMPTS=5

# Tile upload script ("npm run upload-tiles"): the hub's gRPC address
HUB_GRPC_ADDRESS=hub.example.com:9090

# Tile upload script: the catalogue admin key of the hub
CATALOG_ADMIN_KEY=change-me

# Tile upload script: set to true for a plaintext gRPC connection (local hub); anything else uses TLS
# HUB_GRPC_INSECURE=false

# Tile upload script: folder with <symbol>.webp, default tiles/ at the repository root
# TILES_DIR=../tiles
